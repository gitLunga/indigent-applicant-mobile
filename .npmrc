# expo-router 57 pulls `vaul`, whose `@radix-ui/react-dialog` peer range stops at
# React 18. This app is on React 19, so npm's strict peer resolution refuses to
# install anything at all — including packages that have nothing to do with it.
#
# The conflict is confined to expo-router's *web* dependencies, which a native
# build never loads, so accepting the older peer costs nothing here. Without this
# every `npm install <anything>` fails with ERESOLVE.
legacy-peer-deps=true
