{
  "expo": {
    "name": "Indigent Register",
    "slug": "indigent-applicant-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.gov.municipality.indigent",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "za.gov.municipality.indigent",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The municipality needs access to your photos so you can attach a copy of your ID, payslip or affidavit to your application.",
          "cameraPermission": "The municipality needs access to your camera so you can photograph your supporting documents."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Your location is used only to record where your property is, so a verification officer can find it. Giving it is optional."
        }
      ],
      "expo-splash-screen"
    ],
    "scheme": "indigent",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://api.indigent.malcam.co.za/api"
    }
  }
}
